# --- Public-facing domain (used in DoH URLs & CORS allowlist) ---
DOMAIN=abs.whao.tech
API_BASE_URL=https://abs.whao.tech
DNS_BASE_URL=https://abs.whao.tech

# --- JWT (RS256). Generate via `scripts/setup.sh`; paths point inside the container. ---
JWT_ISSUER=dns-guard
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=2592000

# --- AdGuard Home control API ---
# The first-run wizard sets these. After provisioning, put the same credentials here.
ADGUARD_API_USER=admin
ADGUARD_API_PASSWORD=change-me

# --- Argon2id parameters (OWASP minimum) ---
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# --- Auth limits ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
DEFAULT_DAILY_LIMIT=100000

# --- Per-token rate limit (leaky bucket) ---
TOKEN_RATE_LIMIT_PER_MIN=2000

# --- Logging ---
LOG_LEVEL=info
